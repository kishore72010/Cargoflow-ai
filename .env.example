# =========================================================================
# CargoFlow AI – Environment Configuration
# =========================================================================

# Server Port
PORT=3000

# Environment Mode: development | production
NODE_ENV=development

# JWT Secret for Session Cookie Signing (REQUIRED in production)
# Generate a strong 256-bit random key in production
JWT_SECRET=cargoflow_super_secret_jwt_key_2026_change_in_production

# Optional MongoDB Connection String (if omitted, starts embedded MongoMemoryServer)
# MONGO_URI=mongodb://localhost:27017/fleet_db

# Google Gemini API Key for AI Fleet Tactical Briefing (Server-Side Only)
# GEMINI_API_KEY=your_gemini_api_key_here
